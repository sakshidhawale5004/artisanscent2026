{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/dashboard.php",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/crm.php",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin.php",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/products/:productId",
      "destination": "/index.html"
    }
  ]
}
